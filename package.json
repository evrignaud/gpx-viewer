{
  "name": "gpx-viewer",
  "version": "0.2.0",
  "description": "Web viewer that loads and compares many GPX tracks at once on top of switchable map layers.",
  "type": "module",
  "main": "electron-main.js",
  "private": true,
  "homepage": "https://evrignaud.github.io/gpx-viewer/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/evrignaud/gpx-viewer.git"
  },
  "bugs": {
    "url": "https://github.com/evrignaud/gpx-viewer/issues"
  },
  "scripts": {
    "dev": "vite",
    "start": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "serve:dist": "vite preview",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "npm run build && npm run test:integration:run",
    "test:integration:run": "electron --no-sandbox test/integration/run.js",
    "check": "npm run lint && npm run test && npm run build",
    "release": "node scripts/release.js",
    "release:dry-run": "node scripts/release.js --dry-run",
    "clean": "rimraf dist electron-dist",
    "electron": "npm run build && electron .",
    "electron:package": "npm run build && electron-packager . GpxViewer --overwrite --out=electron-dist --ignore=\"^/(src|styles|images|public|node_modules|electron-dist|\\.tmp-verify|\\.github)\""
  },
  "keywords": [
    "map",
    "viewer",
    "gpx",
    "leaflet",
    "elevation",
    "track"
  ],
  "license": "UNLICENSED",
  "author": "Etienne Vrignaud",
  "engines": {
    "node": ">=20.19"
  },
  "dependencies": {
    "@fontsource/lato": "5.3.0",
    "d3": "7.9.0",
    "leaflet": "1.9.4",
    "leaflet-gpx": "2.2.0",
    "leaflet-providers": "3.0.0",
    "leaflet.fullscreen": "5.3.3",
    "leaflet.locatecontrol": "0.90.1",
    "normalize.css": "8.0.1",
    "randomcolor": "0.6.2"
  },
  "devDependencies": {
    "@electron/packager": "20.3.0",
    "@eslint/js": "10.0.1",
    "@stylistic/eslint-plugin": "5.10.0",
    "electron": "44.0.0",
    "eslint": "10.9.1",
    "globals": "17.11.0",
    "jsdom": "30.0.1",
    "rimraf": "6.1.3",
    "vite": "8.2.2",
    "vitest": "4.1.11"
  }
}
